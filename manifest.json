{
  "manifest_version": 3,
  "name": "AutoPager 自动分页",
  "version": "1.0.0",
  "description": "滚动到页面底部时自动加载下一页并拼接到当前页，支持 Discuz!、贴吧、NGA、V2EX、豆瓣、GitHub、Stack Overflow 等常见论坛和社区。",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "shared/storage.js",
        "content/selector.js",
        "content/rules-builtin.js",
        "content/fetcher.js",
        "content/detector.js",
        "content/autopager.js"
      ],
      "css": ["content/ui.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "切换当前站点的自动分页"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
